{
  "manifest_version": 3,
  "name": "Save as MVPDF",
  "version": "1.0.0",
  "description": "Save the article you're reading as an .mvpdf file: exact pages, reflow, links and search by meaning, all on your computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Save as .mvpdf",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this page as .mvpdf" }
  }
}
